# Copie para .env e preencha. O .env nunca vai para o repositório.

# Banco (os padrões já batem com o compose.yaml)
DB_USER=cade
DB_PASSWORD=cade

# E-mail: sem estas variáveis, os e-mails vão para o Mailpit (http://localhost:8025).
# Para enviar de verdade pelo Gmail, use uma senha de app da conta da equipe.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=conta.da.equipe@gmail.com
# MAIL_PASSWORD=senha-de-app
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_FROM=conta.da.equipe@gmail.com

# Administrador criado na subida da aplicação (precisa ser @ucsal.edu.br)
# ADMIN_EMAIL=

# Assinatura do JWT (OBRIGATÓRIA: sem ela o back-end não sobe). Gere com `openssl rand -base64 48`
# e cole aqui. Cada ambiente tem a sua; nunca reaproveite uma chave publicada.
JWT_SECRET=

# Origens do front liberadas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:4200

# Modo demonstração (RF47): contas fictícias, login direto sem código e dados de exemplo. Só para a mostra e
# para desenvolver; NUNCA em um ambiente real, porque dispensa o código de login. Veja demo/README.md.
# SPRING_PROFILES_ACTIVE=demo

# Pasta das fotos dos objetos (fora do Docker). No Docker Compose, as fotos ficam no volume photos-data.
# PHOTOS_DIR=data/photos
