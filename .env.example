# Copie para .env e preencha. O .env nunca vai para o repositório.

# Banco (os padrões já batem com o compose.yaml)
DB_USER=cade
DB_PASSWORD=cade

# E-mail: sem estas variáveis, os e-mails vão para o Mailpit (http://localhost:8025).
# Para enviar de verdade pelo Gmail, use uma senha de app da conta da equipe.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=conta.da.equipe@gmail.com
# MAIL_PASSWORD=senha-de-app
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_FROM=conta.da.equipe@gmail.com

# Assinatura do JWT: gere com `openssl rand -base64 48`
# JWT_SECRET=

# Origens do front liberadas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:4200
